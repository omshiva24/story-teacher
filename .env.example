# Copy this file to .env and fill in your own values. Never commit .env.
GEMINI_API_KEY=your_gemini_api_key_here
# Current fast model from Google AI Studio. gemini-3.5-flash-lite is faster and cheaper.
GEMINI_MODEL=gemini-3.8-flash
# Fact-check stories with Google Search (Gemini 3 models). Set to false to turn off.
GEMINI_GROUNDING=true
PORT=8080
